#!/bin/sh
# Manual diagnostic session; owns only the two child PIDs it starts.
base=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
share=$base/share
if [ ! -d "$share/applications" ]; then
    share=$base/../share
fi
if [ -f "$share/applications/org.mosaic.Files.desktop" ]; then
    XDG_DATA_DIRS="$share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    PATH="$base:$PATH"
    export XDG_DATA_DIRS PATH
fi
setsid=setsid
record_session() {
    if [ -x "$base/shellctl" ]; then
        "$base/shellctl" __session-event "$1" "$2" >/dev/null 2>&1 || :
    fi
}
if ! command -v "$setsid" >/dev/null 2>&1; then
    record_session launcher_failed 1
    printf '%s\n' 'mosaic-session: setsid is required' >&2
    exit 1
fi
# Keep both child PIDs as direct targets for cleanup and leave the
# terminal foreground process group to the runner alone.
set +m
backend=
ui=
cleanup() {
    status=$?
    trap - EXIT HUP INT TERM
    if [ -n "$ui" ]; then kill "$ui" 2>/dev/null || :; wait "$ui" 2>/dev/null || :; fi
    if [ -n "$backend" ]; then kill "$backend" 2>/dev/null || :; wait "$backend" 2>/dev/null || :; fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
record_session start 0
"$setsid" "$base/mosaic-services" </dev/null &
backend=$!
"$setsid" "$base/mosaic-shell" </dev/null &
ui=$!
wait "$ui"
status=$?
ui=
record_session ui_exit "$status"
exit "$status"
